<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- HTTP-Frontend und Orleans-Silo in einem Prozess. Keine Fachlogik, kein Zustand:
       Endpunkt (Mediator-Handler) → Grain-Aufruf. Laeuft mit JIT, siehe ADR-0002. -->
  <PropertyGroup>
    <UserSecretsId>vereine-api</UserSecretsId>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Der Host laeuft mit JIT (ADR-0002): Orleans-Silo und die von Shiny Mediator generierten Endpunkte
         (MapMediatorPost/Get, RequiresDynamicCode) sind nicht AOT-tauglich. AOT-Pruefung gilt fuer die
         Bibliotheken Abstractions, Grains und ServiceDefaults. -->
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <PackageReference Include="Microsoft.Orleans.Dashboard" />
    <PackageReference Include="Shiny.Aspire.Orleans.Server" />
    <PackageReference Include="Shiny.AspNet.WebHosting" />
    <PackageReference Include="Shiny.Mediator.AspNet" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vereine.Abstractions\Vereine.Abstractions.csproj" />
    <ProjectReference Include="..\Vereine.Grains\Vereine.Grains.csproj" />
    <ProjectReference Include="..\Vereine.ServiceDefaults\Vereine.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vereine.Tests" />
  </ItemGroup>

</Project>
